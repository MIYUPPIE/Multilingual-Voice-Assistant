# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Specific GPT model to use (default: gpt-3.5-turbo)
# Other options: gpt-4, gpt-4-turbo-preview
OPENAI_MODEL=gpt-3.5-turbo

# Language settings
# Supported: yoruba, hausa, igbo
DEFAULT_LANGUAGE=yoruba

# Audio settings (optional)
# Sample rate in Hz (default: 16000)
AUDIO_SAMPLE_RATE=16000

# Whisper model size (default: base)
# Options: tiny, base, small, medium, large
WHISPER_MODEL=base

# Text-to-Speech settings (optional)
# Speech rate in words per minute (default: 120)
TTS_RATE=120

# Speech volume (0.0 to 1.0, default: 1.0)
TTS_VOLUME=1.0

# YarnGPT settings
ENABLE_YARNGPT=true
CONTEXT_AWARENESS=true
CULTURAL_CONTEXT=true

# Conversation settings
# Maximum number of previous messages to keep in memory
CONVERSATION_MEMORY_LIMIT=10

# Debug mode (set to true for verbose logging)
DEBUG=false
